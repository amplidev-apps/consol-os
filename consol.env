# Configuração do build do Consol

# Nome da imagem (mesmo nome do repositório no GitHub)
IMAGE_NAME=consol-os

# Usuário/org do GitHub onde as imagens ficarão publicadas (ghcr.io)
REPO_ORGANIZATION="amplidev-apps"

IMAGE_DESC="Consol — distro Linux para jogos, com Steam, emuladores e RecompLauncher nativos (baseada no Bazzite NVIDIA)"
IMAGE_KEYWORDS="gaming,steam,emulation,recomplauncher,bazzite,bootc"
# Logo público (ArtifactHub): ícone de app oficial do Consol OS
IMAGE_LOGO_URL="https://raw.githubusercontent.com/amplidev-apps/consol-os/main/brand/03-app-icon/png/consol-app-icon-512.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
