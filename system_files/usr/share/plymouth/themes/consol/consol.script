// Plymouth theme do Consol OS
// Fundo sólido escuro + marca centralizada + barra de progresso 400x8

Window.SetBackgroundTopColor(0.04, 0.04, 0.04);
Window.SetBackgroundBottomColor(0.04, 0.04, 0.04);

logo.image = Image("consol-plymouth-watermark-200.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 100);

progressbar.image = Image("consol-plymouth-progress-full-400x8.png");
progressbar.empty  = Image("consol-plymouth-progress-empty-400x8.png");
progressbar.sprite = Sprite(progressbar.empty);
progressbar.x = Window.GetX() + Window.GetWidth()  / 2 - progressbar.empty.GetWidth() / 2;
progressbar.y = Window.GetY() + Window.GetHeight() / 2 + 120;
progressbar.sprite.SetPosition(progressbar.x, progressbar.y, 90);

progress = 0;

fun refresh_callback() {
    if (progress > 1) return;
    sprite_width = Math.Int(progressbar.image.GetWidth() * progress);
    progressbar.sprite.SetImage(progressbar.image.Scale(sprite_width, progressbar.image.GetHeight()));
}

fun progress_callback(duration, progress_) {
    progress = progress_;
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_callback);
